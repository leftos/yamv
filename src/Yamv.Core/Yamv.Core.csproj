<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Yamv.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Theming\BuiltIn\*.yamv-theme.json" LogicalName="Yamv.Core.Theming.BuiltIn.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yamv.Core.Tests" />
  </ItemGroup>
</Project>
