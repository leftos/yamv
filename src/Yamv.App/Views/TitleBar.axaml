<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Yamv.App.ViewModels"
  xmlns:chrome="using:Avalonia.Controls.Chrome"
  xmlns:views="using:Yamv.App.Views"
  x:Class="Yamv.App.Views.TitleBar"
  x:DataType="vm:DocumentWindowViewModel"
>
  <UserControl.Styles>
    <!-- A title-bar tool: 28 x 26, radius 6. Rest is the muted glyph on the bar; hover, open, disabled and keyboard focus follow the width-popover mock. -->
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource YamvTextMuted}" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Back" Background="Transparent" CornerRadius="6" BorderBrush="{DynamicResource YamvAccent}" BorderThickness="0">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.tool:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource YamvText}" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ Border#Back">
      <Setter Property="Background" Value="{DynamicResource YamvHoverBackground}" />
    </Style>
    <Style Selector="Button.tool.open">
      <Setter Property="Foreground" Value="{DynamicResource YamvAccent}" />
    </Style>
    <Style Selector="Button.tool.open /template/ Border#Back">
      <Setter Property="Background" Value="{DynamicResource YamvSelectionBackground}" />
    </Style>
    <Style Selector="Button.tool:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.tool:focus-visible /template/ Border#Back">
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.tool Path">
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <!-- The elevated instance's Administrator chip: the warning colours, 18 high, after the location (10 px), or right after the name when there is none. -->
    <Style Selector="Border.admin">
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource YamvWarningBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource YamvWarningLine}" />
    </Style>
    <Style Selector="Border.admin.alone">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Border.admin TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource YamvWarning}" />
    </Style>
  </UserControl.Styles>
  <Border
    x:Name="Bar"
    Height="38"
    Background="{DynamicResource YamvChromeBackground}"
    BorderBrush="{DynamicResource YamvLine}"
    BorderThickness="0,0,0,1"
    chrome:WindowDecorationProperties.ElementRole="TitleBar"
  >
    <DockPanel>
      <StackPanel
        x:Name="TitleBarTools"
        DockPanel.Dock="Right"
        Orientation="Horizontal"
        HorizontalAlignment="Right"
        chrome:WindowDecorationProperties.ElementRole="User"
      >
        <Button
          x:Name="OpenButton"
          Classes="tool"
          ToolTip.Tip="{x:Static views:MainWindow.OpenToolTip}"
          AutomationProperties.Name="Open"
        >
          <Path
            Width="16"
            Height="16"
            Data="M1.8,12.6 V3.2 H5.9 L7.4,4.7 H12.7 V6.8 M1.8,12.6 L3.7,7 H14.3 L12.4,12.6 Z"
            StrokeThickness="1.35"
            StrokeJoin="Round"
          />
        </Button>
        <Button x:Name="ContentWidthButton" Classes="tool" IsEnabled="{Binding CanEditContentWidth}" AutomationProperties.Name="Content width">
          <Path
            Width="16"
            Height="16"
            Data="M1.8,8 H14.2 M4.6,5.2 L1.8,8 L4.6,10.8 M11.4,5.2 L14.2,8 L11.4,10.8"
            StrokeThickness="1.4"
            StrokeLineCap="Round"
            StrokeJoin="Round"
          />
        </Button>
        <!-- Three dots, each a round cap on a stroke too short to see, so the glyph takes the tool's stroke like ⟷. -->
        <Button x:Name="MoreButton" Classes="tool" ToolTip.Tip="More" AutomationProperties.Name="More">
          <Path
            Width="16"
            Height="16"
            Data="M3.39,8 H3.41 M7.99,8 H8.01 M12.59,8 H12.61"
            StrokeThickness="2.6"
            StrokeLineCap="Round"
            StrokeJoin="Round"
          />
        </Button>
      </StackPanel>
      <!--
        Sized to its text, so the Administrator chip, docked right, sits right after the location. A DockPanel measures its
        children in order: the chip first, so it never truncates, then the name, then the location, which truncates first.
      -->
      <DockPanel x:Name="TitleText" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False">
        <Border
          x:Name="AdministratorChip"
          DockPanel.Dock="Right"
          Classes="admin"
          Classes.alone="{Binding TitleLocation, Converter={x:Static StringConverters.IsNullOrEmpty}}"
          IsVisible="{Binding ShowsAdministrator}"
        >
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center">
              <Canvas Width="16" Height="16">
                <Path
                  Data="M8,1.5 L13.5,3.6 L13.5,7.7 C13.5,11 11.2,13.4 8,14.5 C4.8,13.4 2.5,11 2.5,7.7 L2.5,3.6 Z"
                  Stroke="{DynamicResource YamvWarning}"
                  StrokeThickness="1.6"
                  StrokeJoin="Round"
                />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Administrator" />
          </StackPanel>
        </Border>
        <TextBlock
          x:Name="TitleName"
          DockPanel.Dock="Left"
          Text="{Binding TitleName}"
          FontSize="12.5"
          FontWeight="SemiBold"
          TextTrimming="CharacterEllipsis"
          Foreground="{DynamicResource YamvText}"
          Margin="0,0,10,0"
        />
        <TextBlock
          x:Name="TitleLocation"
          Text="{Binding TitleLocation}"
          FontSize="12.5"
          FontWeight="Medium"
          TextTrimming="CharacterEllipsis"
          Foreground="{DynamicResource YamvTextMuted}"
        />
      </DockPanel>
    </DockPanel>
  </Border>
</UserControl>
