<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Yamv.App.Views.ThemeSettings.ImportNoticeDialog"
  IsVisible="False"
>
  <UserControl.Styles>
    <Style Selector="Button.ctl">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="Transparent">
            <Path
              Data="M0,0 L10,10 M10,0 L0,10"
              Stroke="{DynamicResource YamvTextMuted}"
              StrokeThickness="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
            />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>

  <!-- The scrim covers the whole window, so nothing under the notice takes a click while it is open. -->
  <Panel x:Name="Scrim" Background="#6B0F1216">
    <Border
      Width="470"
      Margin="24"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Background="{DynamicResource YamvPageBackground}"
      CornerRadius="10"
      ClipToBounds="True"
      BoxShadow="0 24 60 0 #66000000, 0 0 0 1 #2E000000"
    >
      <DockPanel>
        <Border
          DockPanel.Dock="Top"
          Height="38"
          Padding="16,0,0,0"
          Background="{DynamicResource YamvChromeBackground}"
          BorderBrush="{DynamicResource YamvLine}"
          BorderThickness="0,0,0,1"
        >
          <DockPanel>
            <Button x:Name="NoticeClose" Classes="ctl" DockPanel.Dock="Right" Click="OnCancelClick" AutomationProperties.Name="Close" />
            <TextBlock
              x:Name="NoticeTitle"
              Text="Import a theme"
              VerticalAlignment="Center"
              FontSize="12.5"
              FontWeight="SemiBold"
              Foreground="{DynamicResource YamvText}"
            />
          </DockPanel>
        </Border>
        <Border
          DockPanel.Dock="Bottom"
          Margin="0,10,0,0"
          Padding="16,12"
          Background="{DynamicResource YamvChromeBackground}"
          BorderBrush="{DynamicResource YamvLine}"
          BorderThickness="0,1,0,0"
        >
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="NoticeCancel" Classes="btn" Content="Cancel" Click="OnCancelClick" />
            <Button x:Name="NoticeImport" Classes="btn primary" Content="Import" Click="OnPrimaryClick" />
          </StackPanel>
        </Border>
        <!-- The body scrolls when the file brings many errors or warnings; the footer stays where it is. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="NoticeBody" Margin="20,18,20,6">
            <!-- The file card: its chip, its first line, its path, what it will be added as, its errors and its warnings. -->
            <Border
              Padding="11,9"
              Margin="0,0,0,14"
              CornerRadius="8"
              BorderThickness="1"
              BorderBrush="{DynamicResource YamvLine}"
              Background="{DynamicResource YamvChromeBackground}"
            >
              <DockPanel>
                <Border
                  x:Name="NoticeChip"
                  DockPanel.Dock="Left"
                  Margin="-1,-1,9,-1"
                  VerticalAlignment="Center"
                  CornerRadius="4"
                  BorderBrush="{DynamicResource YamvLine}"
                  BorderThickness="1"
                >
                  <Border Width="30" Height="20" CornerRadius="3" ClipToBounds="True">
                    <Grid x:Name="NoticeChipGrid" ColumnDefinitions="*,*">
                      <Panel x:Name="NoticeChipLight" Grid.Column="0">
                        <Border
                          x:Name="NoticeChipLightBar"
                          Height="2"
                          Margin="3,0,3,2"
                          CornerRadius="1"
                          VerticalAlignment="Bottom"
                        />
                      </Panel>
                      <Panel x:Name="NoticeChipDark" Grid.Column="1">
                        <Border
                          x:Name="NoticeChipDarkBar"
                          Height="2"
                          Margin="3,0,3,2"
                          CornerRadius="1"
                          VerticalAlignment="Bottom"
                        />
                      </Panel>
                    </Grid>
                  </Border>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock x:Name="NoticeLine" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource YamvText}"><Run x:Name="NoticeNameRun" FontWeight="SemiBold" /><Run x:Name="NoticeDetailRun" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource YamvTextMuted}" /></TextBlock>
                  <TextBlock
                    x:Name="NoticePath"
                    FontFamily="JetBrains Mono, Cascadia Mono, Consolas, Menlo, monospace"
                    FontSize="11"
                    Foreground="{DynamicResource YamvTextMuted}"
                    TextWrapping="Wrap"
                  />
                  <TextBlock
                    x:Name="NoticeAddedAs"
                    Margin="0,6,0,0"
                    FontSize="12"
                    LineHeight="18"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource YamvTextSecondary}"
                  />
                  <ItemsControl x:Name="NoticeErrors" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock
                          Text="{Binding}"
                          Margin="0,0,0,4"
                          FontSize="11.5"
                          LineHeight="17"
                          TextWrapping="Wrap"
                          Foreground="{DynamicResource YamvWarning}"
                        />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl x:Name="NoticeWarnings" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <DockPanel Margin="0,0,0,4">
                          <TextBlock
                            DockPanel.Dock="Left"
                            Text="•"
                            Width="12"
                            FontSize="12"
                            Foreground="{DynamicResource YamvTextSecondary}"
                          />
                          <TextBlock
                            Text="{Binding}"
                            FontFamily="JetBrains Mono, Cascadia Mono, Consolas, Menlo, monospace"
                            FontSize="11"
                            LineHeight="16"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource YamvTextSecondary}"
                          />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DockPanel>
            </Border>
            <TextBlock
              Text="A theme file can change:"
              Margin="0,0,0,10"
              FontSize="13"
              LineHeight="19.5"
              Foreground="{DynamicResource YamvText}"
            />
            <StackPanel Margin="0,0,0,12" Spacing="4">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="•" Width="14" FontSize="13" Foreground="{DynamicResource YamvTextSecondary}" />
                <TextBlock
                  Text="colours, fonts and sizes, in the document and in the app's title bar, tree and dialogs;"
                  FontSize="13"
                  LineHeight="19.5"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource YamvText}"
                />
              </DockPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="•" Width="14" FontSize="13" Foreground="{DynamicResource YamvTextSecondary}" />
                <TextBlock
                  Text="the document page, with its own css, added after YAMV's stylesheet. It styles the document only, not the app."
                  FontSize="13"
                  LineHeight="19.5"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource YamvText}"
                />
              </DockPanel>
            </StackPanel>
            <Border
              x:Name="NoticeSafe"
              Padding="11,9"
              Margin="0,0,0,10"
              CornerRadius="8"
              Background="{DynamicResource YamvCodeBackground}"
            >
              <DockPanel>
                <Viewbox Width="14" Height="14" DockPanel.Dock="Left" Margin="0,2,9,0" VerticalAlignment="Top">
                  <Canvas Width="16" Height="16">
                    <Path
                      Data="M8 1.5 13.5 3.5v4c0 3.4-2.4 5.8-5.5 7-3.1-1.2-5.5-3.6-5.5-7v-4z"
                      Stroke="{DynamicResource YamvAccent}"
                      StrokeThickness="1.4"
                      StrokeJoin="Round"
                    />
                  </Canvas>
                </Viewbox>
                <TextBlock
                  Text="Theme css can't run code: the page's Content-Security-Policy blocks scripts."
                  FontSize="13"
                  LineHeight="19.5"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource YamvText}"
                />
              </DockPanel>
            </Border>
            <Border
              Padding="11,9"
              Margin="0,0,0,8"
              CornerRadius="8"
              BorderThickness="1"
              BorderBrush="{DynamicResource YamvWarningLine}"
              Background="{DynamicResource YamvWarningBackground}"
            >
              <DockPanel>
                <Viewbox Width="14" Height="14" DockPanel.Dock="Left" Margin="0,2,9,0" VerticalAlignment="Top">
                  <Canvas Width="16" Height="16">
                    <Path Data="M8 1.6 15 14H1z" Stroke="{DynamicResource YamvWarning}" StrokeThickness="1.4" StrokeJoin="Round" />
                    <Path Data="M8 6v4" Stroke="{DynamicResource YamvWarning}" StrokeThickness="1.5" StrokeLineCap="Round" />
                    <Ellipse Canvas.Left="7.1" Canvas.Top="11.2" Width="1.8" Height="1.8" Fill="{DynamicResource YamvWarning}" />
                  </Canvas>
                </Viewbox>
                <TextBlock
                  Text="Theme css can make the page load images from the web, which can reveal that you opened a document and which links it holds. Import a theme from someone you trust, as you would a browser extension's styles."
                  FontSize="13"
                  LineHeight="19.5"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource YamvText}"
                />
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
