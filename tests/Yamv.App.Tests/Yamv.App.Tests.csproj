<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707: xUnit test names use underscores (Method_State_Expected). -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <!-- Desktop tests show a real window or touch the owner's Recycle Bin or Trash, so a plain run leaves them out. -->
    <!-- -p:DesktopTestFilter="..." replaces the filter. -->
    <DesktopTestFilter Condition="'$(DesktopTestFilter)' == ''">--filter-not-trait "Category=Desktop"</DesktopTestFilter>
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) $(DesktopTestFilter)</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Yamv.App\Yamv.App.csproj" />
    <ProjectReference Include="..\..\src\Yamv.Core\Yamv.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
